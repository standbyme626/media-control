[Unit]
Description=Media web control (fixed pause/play -> winpc bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/media-web.env
ExecStart=/usr/bin/python3 /opt/media-web/app.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
