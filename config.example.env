# 复制到 /etc/media-web.env 后 chmod 600，按需修改
MEDIA_WEB_HOST=0.0.0.0
MEDIA_WEB_PORT=8097
MEDIA_WEB_USER=media
MEDIA_WEB_PASSWORD=change-me          # 留空则服务直接拒所有请求

# Windows 桥（走 SSH 隧道）
MEDIA_BRIDGE_URL=http://127.0.0.1:8765/
MEDIA_BRIDGE_SSH=1
MEDIA_SSH_TARGET=winpc
MEDIA_SSH_PORT=22

# 电脑的局域网地址，用于在线探测与网络唤醒（可选）
MEDIA_WIN_HOST=192.168.1.20
MEDIA_WIN_MAC=aa:bb:cc:dd:ee:ff

# 对外地址（语音页用），以及多端共享的状态缓存
MEDIA_PUBLIC_URL=https://media.example.com
MEDIA_STATUS_TTL=0.8

# 登录失败锁定（可选，默认就是这几个值）
MEDIA_FAIL_MAX=5
MEDIA_FAIL_WINDOW=600
MEDIA_LOCK_SECONDS=900

# 反代后取真实 IP（Cloudflare / nginx）
MEDIA_TRUST_PROXY=1

# 飞书登录（不用可以留空，H5/Basic 仍可用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://media.example.com/feishu/callback
MEDIA_FEISHU_OPENIDS=

# 可选：温湿度卡片（不配就不启用该模块）
MEDIA_CLIMATE_HOST=
MEDIA_CLIMATE_CMD=iot-latest
